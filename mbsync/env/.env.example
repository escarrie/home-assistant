# Gmail : IMAP activé + mot de passe d'application (pas ton mot de passe Google)
MAILBOX_NAME=perso
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=imaps
IMAP_USER=ton.adresse@gmail.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# Tout sauf les dossiers spéciaux Gmail, en gardant les envoyés.
# Si ton Gmail est en français : "[Gmail]/Messages envoyés"
SYNC_PATTERNS=* ![Gmail]* "[Gmail]/Sent Mail"
SYNC_INTERVAL=300
SYNC_MAX_SIZE=25m
