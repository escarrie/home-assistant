# Copier en openclaw/.env (ignoré par git). scripts/install.sh crée le lien
# ~/.openclaw/.env -> openclaw/.env, lu par OpenClaw au démarrage.

# Token donné par @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
# Ton ID utilisateur Telegram NUMÉRIQUE (pas le @pseudo) : seul compte autorisé
TELEGRAM_ALLOWED_USER_ID=123456789

# Modèle Ollama (préchargé par scripts/transcribe.sh pendant la transcription)
OLLAMA_MODEL=qwen3:30b-a3b
